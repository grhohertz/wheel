# Copy to .env and fill in — .env is gitignored, never commit real values.
# Full walkthrough: docs/schwab-setup.md

# --- Schwab API (developer.schwab.com -> Apps) ---------------------------
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
# Must byte-match the callback registered on the app (HTTPS required).
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
# Where OAuth tokens are cached (written 0600; state/ is gitignored).
SCHWAB_TOKEN_PATH=state/schwab_tokens.json

# --- Engine --------------------------------------------------------------
WHEEL_MODE=paper
WHEEL_ACCOUNT_ID=PAPER-0001
WHEEL_STATE_PATH=state/paper_account.json
WHEEL_WATCHLIST=GLD

# --- Optional: Claude advisory layer ------------------------------------
# ANTHROPIC_API_KEY=
